@{
    ViewData["Title"] = "Home";
}

<div class="max-w-3xl mx-auto space-y-7">

    <!-- Hero -->
    <div class="pt-2">
        <h1 class="text-2xl font-semibold"
            style="font-family:var(--ff-display);color:var(--txt-1);letter-spacing:-0.02em">
            Welcome to
            <span style="color:var(--accent-h);font-family:var(--ff-mono)">{</span>
            JsonSmith
            <span style="color:var(--accent-h);font-family:var(--ff-mono)">}</span>
        </h1>
        <p class="mt-2 text-sm" style="color:var(--txt-2)">
            Transform images into structured JSON. Build JSON schemas with AI-generated sample values.
        </p>
    </div>

    <!-- AI status banners (toggled by ai-status.js) -->
    <div id="homeAiOnlineCard"
         class="hidden js-banner-ok">
        <span class="shrink-0 mt-0.5" style="color:var(--ok);font-size:16px">●</span>
        <div>
            <p class="text-sm font-semibold" style="color:var(--ok);font-family:var(--ff-display)">
                JsonSmithAI is online
            </p>
            <p class="text-xs mt-0.5" style="color:var(--txt-2)">All AI-powered features are available.</p>
        </div>
    </div>

    <div id="homeAiOfflineCard"
         class="js-banner-err">
        <span class="shrink-0 mt-0.5" style="color:var(--err);font-size:16px">●</span>
        <div>
            <p class="text-sm font-semibold" style="color:var(--err);font-family:var(--ff-display)">
                JsonSmithAI is offline
            </p>
            <p class="text-xs mt-0.5" style="color:var(--txt-2)">
                Start the FastAPI service, then click the 🤖 orb in the bottom-right to recheck.
            </p>
        </div>
    </div>

    <!-- Feature cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <a id="homeImageToJsonLink"
           asp-controller="Home" asp-action="ImageToJSON"
           class="js-card js-card-hover block"
           style="text-decoration:none">
            <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-xl"
                     style="background:var(--accent-bg);border:1px solid var(--accent-b)">
                    🖼️
                </div>
                <div>
                    <p class="text-sm font-semibold" style="font-family:var(--ff-display);color:var(--txt-1)">
                        Image to JSON
                    </p>
                    <p class="text-xs mt-1" style="color:var(--txt-2)">
                        Upload an image and extract structured JSON via OCR + AI.
                    </p>
                    <span class="inline-block mt-3 text-xs font-medium"
                          style="color:var(--accent-h)">Open →</span>
                </div>
            </div>
        </a>

        <a asp-controller="Home" asp-action="JsonBuilder"
           class="js-card js-card-hover block"
           style="text-decoration:none">
            <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-xl"
                     style="background:var(--surf-2);border:1px solid var(--border)">
                    🧱
                </div>
                <div>
                    <p class="text-sm font-semibold" style="font-family:var(--ff-display);color:var(--txt-1)">
                        JSON Builder
                    </p>
                    <p class="text-xs mt-1" style="color:var(--txt-2)">
                        Build JSON objects and columns with AI-powered unique sample values.
                    </p>
                    <span class="inline-block mt-3 text-xs font-medium"
                          style="color:var(--accent-h)">Open →</span>
                </div>
            </div>
        </a>

    </div>

    <p class="text-xs" style="color:var(--txt-3)">
        Tip: the 🤖 orb in the bottom-right shows live JsonSmithAI status.
    </p>
</div>
