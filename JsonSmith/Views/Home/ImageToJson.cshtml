<div class="max-w-6xl mx-auto space-y-5">

    <!-- Offline banner -->
    <div id="aiOfflineBanner" class="hidden js-banner-err">
        <span class="shrink-0 mt-0.5 text-sm" style="color:var(--err)">⚠</span>
        <div>
            <p class="text-sm font-semibold" style="color:var(--err);font-family:var(--ff-display)">
                JsonSmithAI is not available
            </p>
            <p id="aiOfflineBannerMessage" class="text-xs mt-0.5" style="color:var(--txt-2)">
                Image to JSON is disabled until the AI service is back online.
            </p>
        </div>
    </div>

    <!-- Page header -->
    <div>
        <h1 class="text-xl font-semibold" style="font-family:var(--ff-display);color:var(--txt-1)">
            Image to JSON
        </h1>
        <p class="text-xs mt-1" style="color:var(--txt-2)">
            Upload an image and convert it into structured JSON using OCR and AI extraction.
        </p>
    </div>

    <!-- Two-column workspace -->
    <div id="imageToJsonWorkspace" class="grid grid-cols-1 md:grid-cols-2 gap-5 transition-opacity duration-300">

        <!-- Upload panel -->
        <div class="js-card flex flex-col gap-4">

            <div>
                <span class="js-label">Upload Image</span>

                <!-- Drop zone -->
                <div id="dropZone"
                     class="js-drop-zone border-2 border-dashed rounded-lg cursor-pointer">

                    <input id="fileInput"
                           type="file"
                           accept=".png,.jpg,.jpeg,.webp"
                           multiple
                           class="hidden" />

                    <span style="font-size:28px;opacity:.4">🖼️</span>
                    <p class="text-sm" style="color:var(--txt-2)">
                        Drag & drop or click to browse
                    </p>
                    <p class="text-xs" style="color:var(--txt-3)">PNG · JPG · WebP</p>

                    <!-- Image preview -->
                    <img id="previewImage"
                         class="hidden mt-2 max-h-40 rounded"
                         style="border:1px solid var(--border)"
                         alt="Preview" />
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3">
                <button id="convertBtn"
                        type="button"
                        disabled
                        class="js-btn js-btn-primary">
                    Convert to JSON
                </button>
                <span id="statusText"
                      class="text-xs"
                      style="color:var(--txt-2)">
                    Checking AI service…
                </span>
            </div>
        </div>

        <!-- Output panel -->
        <div class="js-card flex flex-col min-h-[300px] gap-3">

            <!-- Single-file output -->
            <div id="singleOutputPanel">
                <div class="flex items-center justify-between mb-3">
                    <span class="js-label" style="margin-bottom:0">Generated JSON</span>
                    <button id="copyJsonBtn"
                            type="button"
                            disabled
                            title="Copy JSON to clipboard"
                            class="js-btn js-btn-ghost js-btn-sm flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span id="copyJsonBtnLabel">Copy</span>
                    </button>
                </div>

                <pre id="jsonOutput"
                     class="flex-1 rounded-lg overflow-auto text-xs leading-relaxed p-4"
                     style="background:var(--bg);border:1px solid var(--border);font-family:var(--ff-mono);color:var(--txt-2)">{
  "status": "idle",
  "message": "Upload an image to start"
}</pre>
            </div>

            <!-- Batch output panel (shown when multiple files processed) -->
            <div id="batchOutputPanel" class="hidden flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <span class="js-label" style="margin-bottom:0">Batch Results</span>
                    <button id="mergeAllBtn" type="button"
                            class="js-btn js-btn-ghost js-btn-sm hidden">
                        Merge All
                    </button>
                </div>
                <div id="batchResultsList" class="flex flex-col gap-1.5 overflow-auto" style="max-height:160px"></div>
                <pre id="batchJsonViewer"
                     class="flex-1 rounded-lg overflow-auto text-xs leading-relaxed p-3 hidden"
                     style="background:var(--bg);border:1px solid var(--border);font-family:var(--ff-mono);color:var(--txt-2)"></pre>
            </div>
        </div>

    </div>
</div>
