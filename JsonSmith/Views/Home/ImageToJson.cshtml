<div class="max-w-6xl mx-auto space-y-6">

    <!-- Offline banner (shown when JsonSmithAI is down) -->
    <div id="aiOfflineBanner"
         class="hidden rounded-xl border border-red-500/40 bg-red-50 dark:bg-red-950/40 dark:border-red-500/30 p-4">
        <div class="flex items-start gap-3">
            <span class="text-xl shrink-0">⚠️</span>
            <div>
                <p class="font-semibold text-red-900 dark:text-red-100">JsonSmithAI is not available</p>
                <p id="aiOfflineBannerMessage" class="text-sm text-red-800/90 dark:text-red-200/80 mt-1">
                    Image to JSON is disabled until the AI service is back online.
                </p>
            </div>
        </div>
    </div>

    <!-- Header -->
    <div>
        <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">
            Image to JSON
        </h1>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
            Upload an image and convert it into structured JSON using AI.
        </p>
    </div>

    <!-- App Area -->
    <div id="imageToJsonWorkspace" class="grid grid-cols-1 md:grid-cols-2 gap-6 transition-opacity duration-300">

        <!-- Upload Panel -->
        <div class="order-1 md:order-1 rounded-lg border bg-white dark:bg-slate-800 dark:border-slate-700 p-6">

            <h2 class="text-sm font-medium mb-4">Image Upload</h2>

            <!-- Drop Zone -->
            <div id="dropZone"
                 class="border-2 border-dashed rounded-lg p-6 text-center
                        cursor-pointer transition
                        border-slate-300 dark:border-slate-600
                        hover:border-indigo-500">

                <input id="fileInput"
                       type="file"
                       accept=".png,.jpg,.jpeg,.webp"
                       class="hidden" />

                <p class="text-sm text-slate-600 dark:text-slate-400">
                    Drag & drop an image here, or click to browse
                </p>

                <!-- Image Preview -->
                <img id="previewImage"
                     class="hidden mt-4 max-h-48 mx-auto rounded border"
                     alt="Preview" />
            </div>

            <!-- Actions -->
            <div class="mt-4 flex items-center gap-3">
                <button id="convertBtn"
                        type="button"
                        disabled
                        class="px-4 py-2 rounded bg-indigo-600 text-white
                               hover:bg-indigo-700
                               disabled:opacity-60 disabled:cursor-not-allowed">
                    Convert to JSON
                </button>

                <span id="statusText"
                      class="text-xs text-slate-500 dark:text-slate-400">
                    Checking AI service…
                </span>
            </div>
        </div>

        <!-- Output Panel -->
        <div class="order-2 md:order-2 rounded-lg border bg-white dark:bg-slate-800 dark:border-slate-700 p-6 flex flex-col min-h-[280px]">

            <div class="flex items-center justify-between mb-2">
                <h2 class="text-sm font-medium">Generated JSON</h2>

                <button id="copyJsonBtn"
                        type="button"
                        disabled
                        title="Copy JSON to clipboard"
                        class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-md border
                               border-slate-300 dark:border-slate-600
                               hover:bg-slate-100 dark:hover:bg-slate-700
                               disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent
                               transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <span id="copyJsonBtnLabel">Copy</span>
                </button>
            </div>

            <pre id="jsonOutput"
                 class="flex-1 rounded bg-slate-100 dark:bg-slate-900
                        p-4 text-sm text-slate-700 dark:text-slate-300
                        overflow-auto font-mono leading-relaxed">{
  "status": "idle",
  "message": "Upload an image to start"
}</pre>
        </div>

    </div>
</div>
