<div class="flex-1 min-h-0 flex flex-col gap-3">

    <!-- Offline banner -->
    <div id="aiOfflineBanner" class="hidden js-banner-err shrink-0">
        <span class="shrink-0 mt-0.5 text-sm" style="color:var(--err)">⚠</span>
        <div>
            <p class="text-sm font-semibold" style="color:var(--err);font-family:var(--ff-display)">
                JsonSmithAI is not available
            </p>
            <p id="aiOfflineBannerMessage" class="text-xs mt-0.5" style="color:var(--txt-2)">
                Frequency greater than 1 needs JsonSmithAI for unique sample values.
            </p>
        </div>
    </div>

    <!-- Page header -->
    <div class="shrink-0">
        <h1 class="text-xl font-semibold" style="font-family:var(--ff-display);color:var(--txt-1)">
            JSON Builder
        </h1>
        <p class="text-xs mt-0.5" style="color:var(--txt-2)">
            Build JSON with objects and columns. Frequency above 1 generates unique AI samples.
        </p>
    </div>

    <!-- Two-column workspace — fills remaining height -->
    <div id="jsonBuilderWorkspace" class="flex-1 min-h-0 grid grid-cols-1 md:grid-cols-2 gap-4 transition-opacity duration-300">

        <!-- Controls panel (internally scrollable) -->
        <div class="js-card overflow-auto flex flex-col gap-4" style="padding:16px">

            <!-- Create Object -->
            <section class="flex flex-col gap-2">
                <span class="js-label">Create Object</span>

                <div class="flex flex-col gap-1">
                    <label class="text-xs" style="color:var(--txt-3)" for="objectName">Name</label>
                    <input id="objectName" type="text" placeholder="user" class="js-input" style="height:32px;font-size:12px" />
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs" style="color:var(--txt-3)" for="objectTarget">Add inside</label>
                    <select id="objectTarget" class="js-select" style="height:32px;font-size:12px">
                        <option value="">(root)</option>
                    </select>
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs" style="color:var(--txt-3)" for="objectFrequency">Frequency</label>
                    <input id="objectFrequency" type="number" min="1" max="50" value="1" class="js-input" style="height:32px;font-size:12px" />
                </div>

                <button id="createObjectBtn" type="button" class="js-btn js-btn-primary js-btn-sm self-start">
                    Create Object
                </button>
            </section>

            <hr class="js-divider" style="margin:4px 0" />

            <!-- Create Column -->
            <section class="flex flex-col gap-2">
                <span class="js-label">Create Column</span>

                <div class="flex flex-col gap-1">
                    <label class="text-xs" style="color:var(--txt-3)" for="columnName">Name</label>
                    <input id="columnName" type="text" placeholder="name" class="js-input" style="height:32px;font-size:12px" />
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div class="flex flex-col gap-1">
                        <label class="text-xs" style="color:var(--txt-3)" for="columnType">Type</label>
                        <select id="columnType" class="js-select" style="height:32px;font-size:12px">
                            <option value="string">string</option>
                            <option value="int">int</option>
                        </select>
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="text-xs" style="color:var(--txt-3)" for="columnFrequency">Frequency</label>
                        <input id="columnFrequency" type="number" min="1" max="50" value="1" class="js-input" style="height:32px;font-size:12px" />
                    </div>
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs" style="color:var(--txt-3)" for="columnValue">Value (seed)</label>
                    <input id="columnValue" type="text" placeholder="bob" class="js-input" style="height:32px;font-size:12px" />
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs" style="color:var(--txt-3)" for="columnTarget">Add inside</label>
                    <select id="columnTarget" class="js-select" style="height:32px;font-size:12px">
                        <option value="">(root)</option>
                    </select>
                </div>

                <button id="createColumnBtn" type="button" class="js-btn js-btn-primary js-btn-sm self-start">
                    Create Column
                </button>

                <p id="columnStatus" class="text-xs" style="color:var(--txt-2)"></p>
            </section>

            <hr class="js-divider" style="margin:4px 0" />

            <button id="resetJsonBtn" type="button" class="js-btn js-btn-ghost js-btn-sm self-start">
                Reset to {}
            </button>

            <hr class="js-divider" style="margin:4px 0" />

            <!-- Schema Editor -->
            <section class="flex flex-col gap-2">
                <span class="js-label">Target Schema <span class="text-xs font-normal" style="color:var(--txt-3)">(optional)</span></span>
                <p class="text-xs" style="color:var(--txt-3)">
                    Provide a JSON Schema to guide AI sample generation (sent with each Generate Samples request).
                </p>
                <textarea id="schemaEditor"
                          rows="5"
                          placeholder='{ "type": "object", "properties": { "name": { "type": "string", "maxLength": 50 } } }'
                          class="js-input text-xs"
                          style="resize:vertical;font-family:var(--ff-mono);line-height:1.4"></textarea>
                <p id="schemaEditorError" class="hidden text-xs" style="color:var(--err)"></p>
            </section>
        </div>

        <!-- JSON preview panel -->
        <div class="js-card flex flex-col min-h-0" style="padding:16px">

            <div class="flex items-center justify-between shrink-0 mb-2">
                <span class="js-label" style="margin-bottom:0">JSON Preview</span>
                <button id="copyJsonBtn"
                        type="button"
                        title="Copy JSON to clipboard"
                        class="js-btn js-btn-ghost js-btn-sm flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <span id="copyJsonBtnLabel">Copy</span>
                </button>
            </div>

            <pre id="jsonOutput"
                 class="flex-1 min-h-0 overflow-auto rounded-lg text-xs leading-relaxed p-3"
                 style="background:var(--bg);border:1px solid var(--border);font-family:var(--ff-mono);color:var(--txt-2)">{}</pre>
        </div>

    </div>
</div>
