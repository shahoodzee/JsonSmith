<!-- JsonSmithAI status orb (bottom-right) -->
<div id="aiStatusOrb" class="fixed bottom-6 right-6 z-40 flex flex-col items-end gap-2">
    <div id="aiStatusPanel"
         class="hidden w-72 rounded-xl border bg-white dark:bg-slate-800 dark:border-slate-700
                shadow-xl p-4 text-sm transition-all duration-300 opacity-0 translate-y-2"
         role="status"
         aria-live="polite">
        <div class="flex items-start gap-3">
            <div id="aiStatusPanelIcon"
                 class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-700 text-lg">
                🤖
            </div>
            <div class="min-w-0 flex-1">
                <p id="aiStatusPanelTitle" class="font-semibold text-slate-900 dark:text-slate-100">
                    Checking JsonSmithAI…
                </p>
                <p id="aiStatusPanelMessage" class="mt-1 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    Verifying the AI service is reachable.
                </p>
            </div>
        </div>
        <button type="button"
                id="aiStatusRetryBtn"
                class="mt-3 w-full rounded-lg border px-3 py-1.5 text-xs font-medium
                       hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
            Check again
        </button>
    </div>

    <button type="button"
            id="aiStatusOrbBtn"
            title="JsonSmithAI status"
            aria-label="JsonSmithAI status"
            aria-expanded="false"
            class="group relative flex h-14 w-14 items-center justify-center rounded-full
                   border-2 shadow-lg transition-all duration-300
                   bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-600
                   hover:scale-105 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900">
        <span id="aiStatusOrbEmoji" class="text-2xl select-none transition-transform group-hover:scale-110">🤖</span>
        <span id="aiStatusOrbRing"
              class="absolute inset-0 rounded-full border-2 border-transparent animate-pulse"></span>
        <span id="aiStatusOrbDot"
              class="absolute -top-0.5 -right-0.5 h-4 w-4 rounded-full border-2 border-white dark:border-slate-900 bg-slate-400"></span>
    </button>
</div>

<style>
    @@keyframes ai-float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }
    #aiStatusOrbBtn.ai-float {
        animation: ai-float 3s ease-in-out infinite;
    }
    #aiStatusPanel.ai-panel-visible {
        display: block;
        opacity: 1;
        transform: translateY(0);
    }
</style>
