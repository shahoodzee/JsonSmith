<!-- JsonSmithAI status orb (bottom-right) -->
<div id="aiStatusOrb" class="fixed bottom-5 right-5 z-40 flex flex-col items-end gap-2">

    <!-- Panel -->
    <div id="aiStatusPanel"
         class="hidden w-72 rounded-xl p-4 shadow-2xl"
         style="background:var(--surf-1);border:1px solid var(--border);
                transition:opacity .2s, transform .2s;opacity:0;transform:translateY(8px)"
         role="status" aria-live="polite">

        <div class="flex items-start gap-3">
            <div id="aiStatusPanelIcon"
                 class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-base bg-indigo-100 dark:bg-indigo-900/40">
                🤖
            </div>
            <div class="min-w-0 flex-1">
                <p id="aiStatusPanelTitle"
                   class="font-semibold text-sm"
                   style="color:var(--txt-1);font-family:var(--ff-display)">
                    Checking JsonSmithAI…
                </p>
                <p id="aiStatusPanelMessage"
                   class="mt-1 text-xs leading-relaxed"
                   style="color:var(--txt-2)">
                    Verifying the AI service is reachable.
                </p>
            </div>
        </div>

        <button type="button"
                id="aiStatusRetryBtn"
                class="mt-3 w-full rounded-lg px-3 py-1.5 text-xs font-medium transition-opacity hover:opacity-80"
                style="border:1px solid var(--border-2);background:var(--surf-2);color:var(--txt-2);cursor:pointer;font-family:var(--ff-body)">
            Check again
        </button>
    </div>

    <!-- Orb button -->
    <button type="button"
            id="aiStatusOrbBtn"
            title="JsonSmithAI status"
            aria-label="JsonSmithAI status"
            aria-expanded="false"
            class="relative flex h-12 w-12 items-center justify-center rounded-full shadow-lg transition-all duration-300 hover:scale-105 focus:outline-none"
            style="background:var(--surf-1);border:2px solid var(--border-2)">
        <span class="text-xl select-none">🤖</span>
        <span id="aiStatusOrbRing"
              class="absolute inset-0 rounded-full border-2 border-transparent"></span>
        <span id="aiStatusOrbDot"
              class="absolute -top-0.5 -right-0.5 h-3.5 w-3.5 rounded-full border-2 border-white dark:border-slate-900 bg-slate-400"></span>
    </button>

</div>
