@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<aside id="sidebar"
       class="w-60 border-r bg-white dark:bg-slate-800 dark:border-slate-700
              transition-all duration-200 flex flex-col shrink-0">

    <div class="p-3 flex justify-end">
        <button onclick="toggleSidebar()" title="Toggle sidebar"
                class="p-1.5 rounded hover:bg-slate-100 dark:hover:bg-slate-700
                       text-slate-500 dark:text-slate-400">
            <svg id="sidebar-collapse-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
            </svg>
            <svg id="sidebar-expand-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M13 5l7 7-7 7M5 5l7 7-7 7" />
            </svg>
        </button>
    </div>

    <nav class="px-3 pb-4 space-y-1 text-sm">

        <a asp-controller="Home" asp-action="Index"
           title="Home"
           class="flex items-center gap-3 rounded px-3 py-2
           @(action == "Index"
                        ? "bg-indigo-600 text-white"
                        : "hover:bg-indigo-50 dark:hover:bg-slate-700")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" />
            </svg>
            <span class="sidebar-label whitespace-nowrap">Home</span>
        </a>

        <a asp-controller="Home" asp-action="ImageToJSON"
           title="Image to JSON"
           class="flex items-center gap-3 rounded px-3 py-2
           @(action == "ImageToJSON"
                        ? "bg-indigo-600 text-white"
                        : "hover:bg-indigo-50 dark:hover:bg-slate-700")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="sidebar-label whitespace-nowrap">Image to JSON</span>
        </a>

        <a asp-controller="Home" asp-action="JsonBuilder"
           title="JSON Builder"
           class="flex items-center gap-3 rounded px-3 py-2
           @(action == "JsonBuilder"
                        ? "bg-indigo-600 text-white"
                        : "hover:bg-indigo-50 dark:hover:bg-slate-700")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            <span class="sidebar-label whitespace-nowrap">JSON Builder</span>
        </a>

    </nav>
</aside>
