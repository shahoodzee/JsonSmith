@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<aside class="w-60 border-r bg-white dark:bg-slate-800 dark:border-slate-700">
    <nav class="p-4 space-y-1 text-sm">

        <a asp-controller="Home" asp-action="Index"
           class="block rounded px-3 py-2
           @(action == "Index"
                        ? "bg-indigo-600 text-white"
                        : "hover:bg-indigo-50 dark:hover:bg-slate-700")">
            Feature 1
        </a>

        <a asp-controller="Home" asp-action="ImageToJSON"
           class="block rounded px-3 py-2
           @(action == "ImageToJSON"
                        ? "bg-indigo-600 text-white"
                        : "hover:bg-indigo-50 dark:hover:bg-slate-700")">
            Image to JSON
        </a>

        <a asp-controller="Home" asp-action="Feature3"
           class="block rounded px-3 py-2
           @(action == "Feature3"
                        ? "bg-indigo-600 text-white"
                        : "hover:bg-indigo-50 dark:hover:bg-slate-700")">
            Feature 3
        </a>

    </nav>
</aside>
