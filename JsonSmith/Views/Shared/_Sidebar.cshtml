@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<aside id="sidebar"
       class="flex flex-col shrink-0"
       style="width:180px;background:var(--surf-1);border-right:1px solid var(--border)">

    <!-- Collapse toggle -->
    <div class="flex justify-end p-2">
        <button onclick="toggleSidebar()"
                title="Toggle sidebar"
                style="padding:5px;border-radius:5px;color:var(--txt-3);cursor:pointer;background:none;border:none;transition:color .15s">
            <svg id="sidebar-collapse-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
            </svg>
            <svg id="sidebar-expand-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
            </svg>
        </button>
    </div>

    <!-- Navigation section -->
    <nav class="px-2 pb-2 flex flex-col gap-0.5">

        <span class="sidebar-label px-2 pb-1"
              style="font-size:9px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--txt-3)">
            Navigation
        </span>

        <a asp-controller="Home" asp-action="Index"
           title="Home"
           class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm transition-colors"
           style="@(action == "Index"
                    ? "background:var(--accent-bg);color:var(--accent-h);border-left:2px solid var(--accent);font-weight:500"
                    : "color:var(--txt-2)")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" />
            </svg>
            <span class="sidebar-label whitespace-nowrap">Home</span>
        </a>

        <a asp-controller="Home" asp-action="ImageToJSON"
           title="Image to JSON"
           class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm transition-colors"
           style="@(action == "ImageToJSON"
                    ? "background:var(--accent-bg);color:var(--accent-h);border-left:2px solid var(--accent);font-weight:500"
                    : "color:var(--txt-2)")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="sidebar-label whitespace-nowrap">Image to JSON</span>
        </a>

        <a asp-controller="Home" asp-action="JsonBuilder"
           title="JSON Builder"
           class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm transition-colors"
           style="@(action == "JsonBuilder"
                    ? "background:var(--accent-bg);color:var(--accent-h);border-left:2px solid var(--accent);font-weight:500"
                    : "color:var(--txt-2)")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            <span class="sidebar-label whitespace-nowrap">JSON Builder</span>
        </a>

        <!-- Divider -->
        <div class="my-2" style="border-top:1px solid var(--border)"></div>

        <!-- Tools section label -->
        <span class="sidebar-label px-2 pb-1"
              style="font-size:9px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--txt-3)">
            Tools
        </span>

        <!-- Coming soon items -->
        <div class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm cursor-default select-none"
             style="color:var(--txt-3);opacity:.6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
            </svg>
            <span class="sidebar-label whitespace-nowrap flex-1">JSON Diff</span>
            <span class="sidebar-label" style="font-size:9px;opacity:.5">soon</span>
        </div>

        <div class="flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm cursor-default select-none"
             style="color:var(--txt-3);opacity:.6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            <span class="sidebar-label whitespace-nowrap flex-1">Formatter</span>
            <span class="sidebar-label" style="font-size:9px;opacity:.5">soon</span>
        </div>

    </nav>
</aside>
